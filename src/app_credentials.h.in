#pragma once
namespace AppCredentials {
inline constexpr const char *clientId     = "@MSGA_CLIENT_ID@";
inline constexpr const char *clientSecret = "@MSGA_CLIENT_SECRET@";
inline constexpr const char *xapp         = "@MSGA_XAPP@";
// Microsoft Teams (Microsoft Graph) public-client app registration. Multi-tenant,
// no secret (Auth Code + PKCE). teamsTenant is the authority segment for the
// initial sign-in ("organizations" = any work/school tenant; per-workspace refresh
// uses the workspace's own tenant id).
inline constexpr const char *teamsClientId = "@MSGA_TEAMS_CLIENT_ID@";
// Google OAuth "Desktop app" client for Gmail IMAP/SMTP XOAUTH2 (passwordless).
// Empty unless configured + the restricted mail.google.com scope is verified by
// Google; when empty the IMAP add-account flow falls back to app-password login.
inline constexpr const char *googleClientId     = "@MSGA_GOOGLE_CLIENT_ID@";
inline constexpr const char *googleClientSecret = "@MSGA_GOOGLE_CLIENT_SECRET@";
// GIPHY API key for the composer's GIF picker (Tenor's API shut down 2026-06-30).
// Optional: when empty the picker asks the user for their own key in
// Settings → System, which is stored in the OS keychain and takes precedence
// over this baked-in default anyway.
inline constexpr const char *giphyKey = "@MSGA_GIPHY_KEY@";
inline constexpr int         version      = @MSGA_VERSION@;
inline constexpr const char *buildTimestamp = "@MSGA_BUILD_TIMESTAMP@";
}
