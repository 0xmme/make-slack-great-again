# Copy this file to credentials.cmake and fill in your Slack app credentials.
# credentials.cmake is gitignored — never commit the real values.
set(MSGA_CLIENT_ID     "")
set(MSGA_CLIENT_SECRET "")
set(MSGA_XAPP          "")
# Microsoft Teams: the Entra app registration's Application (client) ID
# (multi-tenant public client; no secret needed — Auth Code + PKCE).
set(MSGA_TEAMS_CLIENT_ID "")
# GIPHY API key for the GIF picker in the message composer. Optional — leave
# empty and each user can paste their own key in Settings → System.
# Get one at https://developers.giphy.com/dashboard/ (free keys allow 100
# calls/hour, which the picker caches aggressively to stay under).
set(MSGA_GIPHY_KEY "")
